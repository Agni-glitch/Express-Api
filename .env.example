# Copy this file to config.env (the file server.js loads) and fill in real values.
# config.env is git-ignored; never commit real credentials.

# "development" returns full error details and stack traces, "production" hides them
NODE_ENV=development
PORT=3000

# MongoDB connection string
CONN_STR=mongodb://127.0.0.1:27017/cineflix

# JWT signing secret: use a long random string (32+ characters)
SECRET_STR=replace-with-a-long-random-string
# JWT and login cookie lifetime, e.g. 30d, 12h (a bare number is read as milliseconds)
LOGIN_EXPIRES=30d

# SMTP settings for password reset emails (e.g. a Mailtrap sandbox inbox)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your-smtp-username
EMAIL_PASSWORD=your-smtp-password

# Optional: when set, password reset emails link to the frontend's reset page
FRONTEND_URL=http://localhost:5173

# Optional: number of reverse proxies in front of the API, so rate limiting sees the real client IP.
# Leave unset when clients connect directly. docker-compose.yml sets this itself.
# TRUST_PROXY=1
